```gitignore
# =========================
# Environment variables & secrets
# =========================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/
credentials
.aws/

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# =========================
# Node.js / React
# =========================
node_modules/
dist/
build/
.next/
out/
coverage/
.npm/

# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# IDEs and editors
# =========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# =========================
# AWS
# =========================
.aws-sam/
cdk.out/
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*
.terraform/
crash.log

# =========================
# Logs and temporary files
# =========================
*.log
tmp/
temp/
